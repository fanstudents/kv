# Local authentication — required for /login and protected-page functional checks
AUTH_SECRET=
ADMIN_PASSWORD=
APP_BASE_URL=http://localhost:3000

# Main Supabase — required for real backend data; service-role is server-only/write-capable, anon is staging/RLS-bound
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Exact online staging project allowlist; project ref is not a secret
KV_STAGING_PROJECT_REF=
# Opt-in gate for write-and-cleanup staging DB acceptance
ORDERS_STAGING_DB_ACCEPTANCE=0

# OpenAI — key required only for real provider calls; budgets are optional cost guardrails
OPENAI_API_KEY=
AI_DAILY_BUDGET_USD=
AI_MONTHLY_BUDGET_USD=
# Local-only opt-in for paid OpenAI acceptance; approve US$0.05-US$0.10 per run before enabling
OPENAI_ACCEPTANCE=0
OPENAI_ACCEPTANCE_MAX_USD=0.05

# Primary LINE — write-capable delivery/webhook channel; secret and access token are required for real use
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Support LINE — write-capable delivery/webhook channel; secret and access token are required for real use
LINE_SUPPORT_CHANNEL_ID=
LINE_SUPPORT_CHANNEL_SECRET=
LINE_SUPPORT_CHANNEL_ACCESS_TOKEN=

# Google — read-only Calendar/GA4/GSC capabilities; OAuth values plus each resource ID are required per capability
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ADDITIONAL_CALENDAR_IDS=
GA4_PROPERTY_ID=
GSC_SITE_URL=

# Knowledge crawling — Firecrawl is write-capable for crawl/import workflows; base URL is optional override
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE=

# Webhooks/cron/relay — verification and internal-trigger secrets; relay target is write-capable and optional until Support acceptance
TEACHIFY_WEBHOOK_SECRET=
CRON_SECRET=
SUPPORT_LOG_SECRET=
SUPPORT_RELAY_TARGET_URL=

# Teaching-system Supabase — read-only source, separate from Main migration/type ownership
TEACHING_SUPABASE_URL=
TEACHING_SUPABASE_ANON_KEY=
