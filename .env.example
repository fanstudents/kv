# Local authentication — required for /login and protected-page functional checks
AUTH_SECRET=
ADMIN_PASSWORD=
APP_BASE_URL=http://localhost:3000
KV_RUNTIME_ENV=local
KV_APP_VERSION=
KV_COMMIT_SHA=
KV_SCHEMA_VERSION=

# Main Supabase — required for real backend data; service-role is server-only/write-capable, anon is staging/RLS-bound
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Exact online staging project allowlist; project ref is not a secret
KV_STAGING_PROJECT_REF=
KV_LIVE_PROJECT_REF=
# Server-only Postgres connection used only by the guarded release migration CLI
SUPABASE_DB_URL=
# Explicit release gates; keep disabled outside an approved migration window
KV_RELEASE_BACKUP_CONFIRMED=0
KV_RELEASE_MIGRATION_APPLY=0
# Opt-in gate for write-and-cleanup staging DB acceptance
AGENT_RUN_COST_STAGING_DB_ACCEPTANCE=0
CONVERSATION_LOCK_STAGING_DB_ACCEPTANCE=0
ORDERS_STAGING_DB_ACCEPTANCE=0

# OpenAI — key required only for real provider calls; budgets are optional cost guardrails
OPENAI_API_KEY=
AI_DAILY_BUDGET_USD=
AI_MONTHLY_BUDGET_USD=
# Local-only opt-in for paid OpenAI acceptance; approve US$0.05-US$0.10 per run before enabling
OPENAI_ACCEPTANCE=0
OPENAI_ACCEPTANCE_MAX_USD=0.05

# Primary LINE — write-capable delivery/webhook channel; secret and access token are required for real use
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Explicit opt-in: sends one real UTF-8 message to this exact allowlisted user and cleans its staging activity row
LINE_PRIMARY_ACCEPTANCE=0
LINE_ACCEPTANCE_USER_ID=
# Destructive opt-in: sends exactly 3 Primary LINE messages while exercising Broadcast, Orders, and Team Lead; all DB fixtures/settings are restored
PRIMARY_COMPOSITE_ACCEPTANCE=0
PRIMARY_COMPOSITE_ACCEPTANCE_MAX_MESSAGES=3

# Support LINE — write-capable delivery/webhook channel; secret and access token are required for real use
LINE_SUPPORT_CHANNEL_ID=
LINE_SUPPORT_CHANNEL_SECRET=
LINE_SUPPORT_CHANNEL_ACCESS_TOKEN=

# Google — read-only Calendar/GA4/GSC capabilities; OAuth values plus each resource ID are required per capability
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ADDITIONAL_CALENDAR_IDS=
GA4_PROPERTY_ID=
GSC_SITE_URL=
# Explicit opt-in for provider-backed Calendar/GA4/GSC read acceptance
GOOGLE_READ_ACCEPTANCE=0
# Destructive opt-in: creates then deletes one Calendar event and sends one Gmail to this exact recipient
GOOGLE_WRITE_ACCEPTANCE=0
GOOGLE_WRITE_ACCEPTANCE_RECIPIENT=
# Destructive opt-in: writes synthetic Main staging rows and sends Calendar/Gmail to the exact recipient above
VISIT_DELIVERY_ACCEPTANCE=0

# Knowledge crawling — Firecrawl is write-capable for crawl/import workflows; base URL is optional override
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE=

# Webhooks/cron/relay — verification and internal-trigger secrets; relay target is write-capable and optional until Support acceptance
TEACHIFY_WEBHOOK_SECRET=
CRON_SECRET=
SUPPORT_LOG_SECRET=
SUPPORT_RELAY_TARGET_URL=
SUPPORT_MAIN_ACCEPTANCE=0

# Teaching-system Supabase — read-only source, separate from Main migration/type ownership
TEACHING_SUPABASE_URL=
TEACHING_SUPABASE_ANON_KEY=
