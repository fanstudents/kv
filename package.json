{
  "name": "agent-kv",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:smoke": "npm run build && playwright test --grep-invert @visual",
    "test:e2e:run:smoke": "playwright test --grep-invert @visual",
    "test:e2e:update": "npm run build && playwright test --grep @visual --update-snapshots",
    "acceptance:openai": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.acceptance.config.mts",
    "schema:start": "npx --no-install supabase db start --yes",
    "schema:rehearse": "npx --no-install supabase db start --yes && npx --no-install supabase db reset --local --no-seed --yes",
    "schema:types": "npx --no-install supabase gen types typescript --local --schema public > src/lib/database.types.ts",
    "schema:types:check": "npm run schema:types && git diff --exit-code -- src/lib/database.types.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "verify:full": "npm run verify && npm run test:e2e:run:smoke"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.6",
    "clsx": "^2.1.1",
    "googleapis": "^173.0.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "openai": "7.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "supabase": "2.110.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
